# ============================================================
# BlockMemoryAgent 环境变量配置
# 复制此文件为 .env 并填入实际值: cp .env.example .env
# ============================================================

# provider=openai-chat 端点（OpenAI 兼容 /v1/chat/completions；Responses API 用 openai-responses + /v1/responses）
# DeepSeek:      https://api.deepseek.com/v1
# OpenAI:        https://api.openai.com/v1
# Moonshot/Kimi: https://api.moonshot.cn/v1
# 通义千问:       https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_BASE_URL=https://api.deepseek.com/v1

# provider=anthropic 端点（Anthropic 原生 Messages API）
# 注意：anthropic provider 走官方 SDK（option.WithBaseURL），base_url 填根地址即可，
# SDK 会自动追加 /v1/messages。不要自己带 /v1/messages 后缀，
# 否则会拼成 .../v1/messages/v1/messages 导致 403。示例：
#   Claude 原生:        https://api.anthropic.com
#   Kimi Code:          https://api.kimi.com/coding
#   火山方舟 Coding Plan: https://ark.cn-beijing.volces.com/api/coding
ANTHROPIC_BASE_URL=https://api.anthropic.com

# provider=ollama 端点（Ollama 原生 /api/chat）
# 默认 http://localhost:11434；Ollama 不需要 API Key。
OLLAMA_BASE_URL=http://localhost:11434

# Embedding 端点（OpenAI 兼容 /v1/embeddings；配置在 roles.yaml 的 embed 段）
# 豆包方舟示例: https://ark.cn-beijing.volces.com/api/v3
EMBEDDING_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# ---- LLM 模型配置 ----
# openai provider 使用的 API Key（OpenAI 兼容后端）
OPENAI_API_KEY=sk-your-openai-api-key
# anthropic provider 使用的 API Key（Claude 原生 API）
ANTHROPIC_API_KEY=sk-ant-api03-your-anthropic-key
# ollama provider 通常不需要 API Key
OLLAMA_API_KEY=
# Embedding API Key
EMBEDDING_API_KEY=sk-your-embedding-api-key

# Firecrawl API Key（web_search 插件）
# 默认走官方云端免 key 端点（https://mcp.firecrawl.dev/v2/mcp），无需填写；
# 配 key 后可在 config/plugins.yaml 改走备选 2（stdio npx firecrawl-mcp）获得全工具与更高配额，
# key 在 https://firecrawl.dev/app/api-keys 申请（fc-xxx）
FIRECRAWL_API_KEY=

# Open Design 访问令牌（docker-compose.yml 的 open_design 服务，127.0.0.1:7456）
# 必填：任意长随机串（如 openssl rand -hex 32）；
# 用于 http://localhost:7456 的 Basic 认证（用户名 open-design）
OD_API_TOKEN=

# ---- PostgreSQL 配置 ----
POSTGRES_DSN=postgres://blockmemory:blockmemory_dev@localhost:5432/blockmemory?sslmode=disable

# ---- Redis 配置 ----
REDIS_ADDR=localhost:6380
REDIS_PASSWORD=

# ---- HTTP 服务配置 ----
# 缺省只绑 127.0.0.1（config.yaml 同款默认）。局域网访问需显式放开：
HTTP_ADDR=127.0.0.1:10010
# 局域网/容器场景改为 0.0.0.0:10010（docker 容器内必须显式设置，回环地址容器外不可达）。
# HTTP_ADDR=0.0.0.0:10010

# API 鉴权 Token（启用 auth_enabled 时必填）
BMA_API_TOKEN=change-me-to-a-random-strong-token

# ---- 媒体生成（open_design/ui_design 插件：生图 + 生视频）----
# 【唯一配置点】2026-10-14 单点化后，媒体模型/网关/key 只在**仓库根 .env 媒体段**配置
# （本示例中即为下面这组键；部署目录 .env 不再参与媒体配置）。改完运行：
#     bash docker/bma-plugin.sh media
# 即重写 open_design 容器配置并换 ui_design keeper 生效；桥自动向 daemon 探测默认模型，
# 无需重启后端。三通道模板（任选其一，整块套用）：
#
# ---- 能力声明（2026-10-24，非敏感，可选）----
# 桥（ui_design MCP）按这里声明的能力做**本地校验**：未声明的能力（尤其 image_edit /
# inpaint）一律在发上游请求之前拒绝，绝不静默丢弃参数。省略 = 保守默认集：
#   图像 t2i,subject_reference,aspect ；视频 t2v,i2v,aspect,duration
# 例：只有真的配了带遮罩/保真度的局部编辑通道才声明 image_edit；否则“只改腿、其它不变”
# 这类请求会被本地报错（而不是画一张看着差不多但已经换角色的图）。
# 扩展画幅 3:2 / 2:3 需额外声明 aspect_3:2 / aspect_2:3。
# 生效方式：经 plugins.yaml 的 ${IMAGE_CAPABILITIES:}/${VIDEO_CAPABILITIES:} 插值进
# ui_design 桥容器环境（daemon 的 /api/media/config 会丢弃未知字段，故不走探测）；
# 改完需重启后端（插件 env 在插件 Init 时定型）并换 ui_design keeper。
#IMAGE_CAPABILITIES=t2i,subject_reference,aspect
#VIDEO_CAPABILITIES=t2v,i2v,aspect,duration
#
# ── 模板 A｜聚合网关（图像+视频一个入口；Gemini/Imagen/Veo 等 OpenAI 兼容网关）──
#IMAGE_PROVIDER=custom-image
#IMAGE_URL=https://your-image-gateway/v1/images/generations
#IMAGE_KEY=sk-xxx
#IMAGE_MODEL=<图片模型名>
#VIDEO_PROVIDER=openai
#VIDEO_URL=https://your-video-gateway/v1     # API 根；不要带 /contents/generations/tasks 或 /videos 后缀
#VIDEO_KEY=sk-xxx
#VIDEO_MODEL=<视频模型名>                     # 裸名即可，桥自动补 aihubmix- 前缀
#
# ── 模板 B｜Google 官方（仅图像；视频需另配聚合网关——daemon 无官方视频渲染器）──
#IMAGE_PROVIDER=nanobanana
#IMAGE_MODEL=gemini-3.1-flash-image-preview
#IMAGE_KEY=AIza...                           # GEMINI/GOOGLE key
#IMAGE_URL=                                  # 留空=官方端点；也可填兼容网关根
# （注意：nanobanana 通道不支持参考图 reference/i2i）
#
# ── 模板 C｜火山方舟 Agent Plan（2026-10-17 更新：Seedream 5.x / Seedance 2.x）──
# 需 Agent Plan 专属 API Key（ark.cn-beijing.volces.com 控制台"Agent Plan"页签获取；
# Coding Plan / 普通方舟 Key 不通）。模型 id 用 daemon 目录 id（连字符+日期后缀格式），
# 可选值见桥启动日志或 GET http://localhost:7456/api/media/models。
#IMAGE_PROVIDER=custom-image
#IMAGE_URL=https://ark.cn-beijing.volces.com/api/plan/v3/images/generations
#IMAGE_KEY=ark-xxx
#IMAGE_MODEL=doubao-seedream-5.0-pro                      # 生图（Agent Plan 模型名，点格式；轻量场景可换 doubao-seedream-5.0-lite）
#VIDEO_PROVIDER=volcengine
#VIDEO_URL=https://ark.cn-beijing.volces.com/api/plan/v3    # API 根
#VIDEO_KEY=ark-xxx
#VIDEO_MODEL=doubao-seedance-2-0-fast-xxx                    # 生视频（seedance 2.x；对齐桥内默认 2.0 fast；
                                                             #  文档模型名 doubao-seedance-2.0/2.0-fast/2.0-mini
                                                             #  对应目录 id 以 /api/media/models 为准）
# 已知边界（2026-10-17）：seedance-2.0 新参数（generate_audio 生成音效、首尾帧 i2v、
# 图片+音频/视频+音频多模态参考）尚未贯通 od_video_generate，当前仅支持 t2v + 首帧 i2v；
# 需要这些能力要另做 daemon 桥接补丁（见 doc/变更.md 待办）。
#
# ── 模板 D｜MiniMax（图 + 视频同源；2026-10-23 起由本地适配桥 docker/minimax-media 提供）──
# 适配桥把 MiniMax 的 /v1/image_generation、/v1/video_generation 翻译成 daemon 认的
# 两种形状（custom-image 的 OpenAI /images/generations、grok 线的 /videos/generations +
# 轮询），daemon 与 ui_design 桥零改动。启动：docker compose -f docker/docker-compose.yml
# up -d --build minimax-media（bma-plugin.sh media 会自动拉起）。
# Key：M Plan 订阅 Key（sk-cp-…）或开放平台按量 Key 均可（订阅 Key 按目录价扣套餐额度）。
# 注意：i2i 是 MiniMax 的 subject_reference（人物/主体参考），不是通用重绘；
#       H3 / H3-Max 走 /v2 端点（2026-10-23 用 M Plan 订阅 Key 实测可用），官方时长下限
#       H3 = 4s、H3-Max = 5s——**不支持 1~3s**；H3 分辨率仅 768P/2K，H3-Max 才支持 480P。
#IMAGE_PROVIDER=custom-image
#IMAGE_URL=http://minimax-media:8787/v1/images/generations
#IMAGE_MODEL=image-01                        # 或 image-01-live
#IMAGE_KEY=sk-cp-xxxxxxxx
#VIDEO_PROVIDER=grok
#VIDEO_URL=http://minimax-media:8787/v1       # API 根
#VIDEO_MODEL=grok-imagine-video               # 目录 id（触发 daemon grok 渲染器）；真实模型见下行
#VIDEO_KEY=sk-cp-xxxxxxxx
#MINIMAX_BASE_URL=https://api.minimaxi.com    # 区域：国内站默认；国际站 https://api.minimax.io
#MINIMAX_VIDEO_MODEL=MiniMax-H3              # H3 / H3-Max（v2 端点）；或 MiniMax-Hailuo-2.3 / T2V-01*（v1，6s/10s）
#MINIMAX_VIDEO_DURATION=4                    # 钉死时长；H3 下限 4（不支持 1~3s）。留空=按请求取允许值
#MINIMAX_VIDEO_RESOLUTION=768P               # v1 端点：768P | 1080P（1080P 仅 6s）
#MINIMAX_VIDEO_V2_RESOLUTION=768P            # v2 端点：768P | 2K（H3）；H3-Max 可 480P
