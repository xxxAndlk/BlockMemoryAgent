# ============================================================
# BlockMemoryAgent 环境变量配置
# 复制此文件为 .env 并填入实际值: cp .env.example .env
# ============================================================

# provider=openai 端点（OpenAI 兼容 /v1/chat/completions）
# DeepSeek:      https://api.deepseek.com/v1
# OpenAI:        https://api.openai.com/v1
# Moonshot/Kimi: https://api.moonshot.cn/v1
# 通义千问:       https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_BASE_URL=https://api.deepseek.com/v1

# provider=anthropic 端点（Anthropic 原生 Messages API）
# 注意：本项目的 anthropic provider 把 base_url 当作完整请求 URL（不再追加路径），
# 因此必须写到 /v1/messages 为止。示例：
#   Claude 原生:        https://api.anthropic.com/v1/messages
#   Kimi Code:          https://api.kimi.com/coding/v1/messages
#   火山方舟 Coding Plan: https://ark.cn-beijing.volces.com/api/coding/v1/messages
#   火山方舟标准 API:    https://ark.cn-beijing.volces.com/api/compatible/v1/messages
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1/messages

# provider=ollama 端点（Ollama 原生 /api/chat）
# 默认 http://localhost:11434；Ollama 不需要 API Key。
OLLAMA_BASE_URL=http://localhost:11434

# Embedding 端点（OpenAI 兼容 /v1/embeddings；配置在 roles.yaml 的 embed 段）
# 豆包方舟示例: https://ark.cn-beijing.volces.com/api/v3
EMBEDDING_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# ---- LLM 模型配置 ----
# openai provider 使用的 API Key（OpenAI 兼容后端）
OPENAI_API_KEY=sk-your-openai-api-key
# anthropic provider 使用的 API Key（Claude 原生 API）
ANTHROPIC_API_KEY=sk-ant-api03-your-anthropic-key
# ollama provider 通常不需要 API Key
OLLAMA_API_KEY=
# Embedding API Key
EMBEDDING_API_KEY=sk-your-embedding-api-key

# ---- PostgreSQL 配置 ----
POSTGRES_DSN=postgres://blockmemory:blockmemory_dev@localhost:5432/blockmemory?sslmode=disable

# ---- Redis 配置 ----
REDIS_ADDR=localhost:6380
REDIS_PASSWORD=

# ---- HTTP 服务配置 ----
HTTP_ADDR=:10010

# API 鉴权 Token（启用 auth_enabled 时必填）
BMA_API_TOKEN=change-me-to-a-random-strong-token
