# ============================================================
# BlockMemoryAgent 环境变量配置
# 复制此文件为 .env 并填入实际值: cp .env.example .env
# ============================================================

# provider=openai-chat 端点（OpenAI 兼容 /v1/chat/completions；Responses API 用 openai-responses + /v1/responses）
# DeepSeek:      https://api.deepseek.com/v1
# OpenAI:        https://api.openai.com/v1
# Moonshot/Kimi: https://api.moonshot.cn/v1
# 通义千问:       https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_BASE_URL=https://api.deepseek.com/v1

# provider=anthropic 端点（Anthropic 原生 Messages API）
# 注意：anthropic provider 走官方 SDK（option.WithBaseURL），base_url 填根地址即可，
# SDK 会自动追加 /v1/messages。不要自己带 /v1/messages 后缀，
# 否则会拼成 .../v1/messages/v1/messages 导致 403。示例：
#   Claude 原生:        https://api.anthropic.com
#   Kimi Code:          https://api.kimi.com/coding
#   火山方舟 Coding Plan: https://ark.cn-beijing.volces.com/api/coding
ANTHROPIC_BASE_URL=https://api.anthropic.com

# provider=ollama 端点（Ollama 原生 /api/chat）
# 默认 http://localhost:11434；Ollama 不需要 API Key。
OLLAMA_BASE_URL=http://localhost:11434

# Embedding 端点（OpenAI 兼容 /v1/embeddings；配置在 roles.yaml 的 embed 段）
# 豆包方舟示例: https://ark.cn-beijing.volces.com/api/v3
EMBEDDING_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# ---- LLM 模型配置 ----
# openai provider 使用的 API Key（OpenAI 兼容后端）
OPENAI_API_KEY=sk-your-openai-api-key
# anthropic provider 使用的 API Key（Claude 原生 API）
ANTHROPIC_API_KEY=sk-ant-api03-your-anthropic-key
# ollama provider 通常不需要 API Key
OLLAMA_API_KEY=
# Embedding API Key
EMBEDDING_API_KEY=sk-your-embedding-api-key

# Firecrawl API Key（web_search 插件）
# 默认走本地自托管栈（docker/docker-compose.firecrawl.yml），无需填写；
# 仅当改用 firecrawl 云端 API 时，在 https://firecrawl.dev/app/api-keys 申请并填入 fc-xxx
FIRECRAWL_API_KEY=

# Open Design 访问令牌（open_design 画图插件，kind: service）
# enable 前必填：任意长随机串（如 openssl rand -hex 32）；
# 用于 http://localhost:7456 的 Basic 认证（用户名 open-design）
OD_API_TOKEN=

# ---- PostgreSQL 配置 ----
POSTGRES_DSN=postgres://blockmemory:blockmemory_dev@localhost:5432/blockmemory?sslmode=disable

# ---- Redis 配置 ----
REDIS_ADDR=localhost:6380
REDIS_PASSWORD=

# ---- HTTP 服务配置 ----
# 缺省只绑 127.0.0.1（config.yaml 同款默认）。局域网访问需显式放开：
HTTP_ADDR=127.0.0.1:10010
# 局域网/容器场景改为 0.0.0.0:10010（docker 容器内必须显式设置，回环地址容器外不可达）。
# HTTP_ADDR=0.0.0.0:10010

# API 鉴权 Token（启用 auth_enabled 时必填）
BMA_API_TOKEN=change-me-to-a-random-strong-token

# ---- 媒体生成（open_design/ui_design 插件：生图 + 生视频，统一入口只填这里）----
# 生图：OpenAI 兼容 /images/generations 网关（URL 填到网关根，不含路径后缀）
#IMAGE_URL=http://your-image-gateway
#IMAGE_KEY=sk-xxx
#IMAGE_MODEL=imagen
# 生视频：provider=openai（OpenAI /videos 协议网关，模型名任意）
#   或 volcengine（方舟 tasks 协议；key 复用生图 IMAGE_KEY 槽位，VIDEO_KEY 不生效；
#   自定义接入点需配 OD_MEDIA_MODEL_ALIASES，见 config/plugins.yaml open_design 注释）
#VIDEO_URL=https://your-video-gateway
#VIDEO_KEY=sk-xxx
#VIDEO_MODEL=veo-3.1-fast
#VIDEO_PROVIDER=openai
