# ============================================================
# BlockMemoryAgent 环境变量配置
# 复制此文件为 .env 并填入实际值: cp .env.example .env
# ============================================================

# ---- LLM 模型配置 ----
# OpenAI 兼容 API Key（必填）
OPENAI_API_KEY=sk-your-openai-api-key

# API 端点（可选，默认 https://api.deepseek.com/v1）
# DeepSeek:    https://api.deepseek.com/v1
# OpenAI:      https://api.openai.com/v1
# 通义千问:     https://dashscope.aliyuncs.com/compatible-mode/v1
# 本地 Ollama:  http://localhost:11434/v1
OPENAI_BASE_URL=https://api.deepseek.com/v1

# ---- PostgreSQL 配置 ----
POSTGRES_DSN=postgres://blockmemory:blockmemory_dev@localhost:5432/blockmemory?sslmode=disable

# ---- Redis 配置 ----
REDIS_ADDR=localhost:6380
REDIS_PASSWORD=

# ---- HTTP 服务配置 ----
HTTP_ADDR=:10010
